---
import Layout from "../layouts/Layout.astro";
---

<Layout title="TauriKit — Ship Rust Tauri Desktop Apps Fast">
  <!-- Nav -->
  <nav class="fixed top-0 w-full z-50 border-b border-zinc-800/50 bg-zinc-950/80 backdrop-blur-lg">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight">
        <span class="text-orange-500">Tauri</span>Kit
      </a>
      <div class="flex items-center gap-6 text-sm text-zinc-400">
        <a href="#features" class="hover:text-white transition">Features</a>
        <a href="#pricing" class="hover:text-white transition">Pricing</a>
        <a href="https://docs.taurikit.dev" class="hover:text-white transition">Docs</a>
        <a
          href="#pricing"
          class="bg-orange-600 hover:bg-orange-500 text-white px-4 py-2 rounded-lg font-medium transition"
        >
          Get TauriKit
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-700 bg-zinc-900 text-sm text-zinc-400 mb-8">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Built for Tauri v2 + React + TypeScript
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight">
        Ship desktop apps<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500">
          in minutes, not months
        </span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        A production-ready starter kit for Rust Tauri desktop apps.
        Auth, settings, UI components, and auto-updates — all wired up.
        Pick your stack. Run one command. Start building.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="bg-orange-600 hover:bg-orange-500 text-white px-8 py-3.5 rounded-xl font-semibold text-lg transition shadow-lg shadow-orange-600/20"
        >
          Get TauriKit — $49
        </a>
        <a
          href="#features"
          class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-8 py-3.5 rounded-xl font-medium text-lg transition"
        >
          See what's included
        </a>
      </div>
      <div class="mt-12 max-w-2xl mx-auto">
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 text-left font-mono text-sm">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="text-zinc-500">
            <span class="text-zinc-400">$</span>
            <span class="text-orange-400"> taurikit</span>
            <span class="text-zinc-300"> new</span>
            <span class="text-green-400"> "My App"</span>
            <span class="text-zinc-500"> --auth github --ui shadcn</span>
          </div>
          <div class="mt-2 text-zinc-600">
            ✓ Copied base template<br />
            ✓ Applied auth/github overlay<br />
            ✓ Applied ui/shadcn overlay<br />
            ✓ Installed dependencies<br />
            <span class="text-green-400">✓ Project ready at ./my-app</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech logos -->
  <section class="py-12 border-y border-zinc-800/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-sm text-zinc-500 uppercase tracking-widest mb-6">Built with battle-tested technology</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14 text-zinc-500">
        <div class="flex items-center gap-2 text-lg font-semibold">
          <span class="text-2xl">🦀</span> Rust
        </div>
        <div class="flex items-center gap-2 text-lg font-semibold">Tauri v2</div>
        <div class="flex items-center gap-2 text-lg font-semibold">React 19</div>
        <div class="flex items-center gap-2 text-lg font-semibold">TypeScript</div>
        <div class="flex items-center gap-2 text-lg font-semibold">Tailwind v4</div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">
          Everything you need to ship
        </h2>
        <p class="mt-4 text-zinc-400 text-lg max-w-2xl mx-auto">
          Stop wiring boilerplate. TauriKit gives you a complete foundation so you can focus on what makes your app unique.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">🔐</div>
          <h3 class="text-lg font-semibold mb-2">Auth — Ready to Go</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            GitHub OAuth (Device Flow), Google OAuth (PKCE loopback), or no-auth.
            Token persistence, session restoration, and sign-out — all wired up.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">🎨</div>
          <h3 class="text-lg font-semibold mb-2">Pick Your UI</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            shadcn/ui or daisyUI — your choice. Pre-configured with Tailwind v4,
            dark mode, and responsive layouts out of the box.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">⚙️</div>
          <h3 class="text-lg font-semibold mb-2">Settings System</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Persistent settings with Tauri plugin-store. Theme switching, workspace folder selection,
            and a clean settings UI — already built.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">📦</div>
          <h3 class="text-lg font-semibold mb-2">Modular Architecture</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Clean overlay system — base template + auth module + UI module.
            Every combination compiles with zero warnings. No dead code.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">🖥️</div>
          <h3 class="text-lg font-semibold mb-2">Custom Title Bar</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Native-feeling custom title bar with window controls, app menu,
            and user avatar. Works on Windows, macOS, and Linux.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 hover:border-zinc-700 transition">
          <div class="w-10 h-10 rounded-lg bg-orange-600/10 flex items-center justify-center text-xl mb-4">🚀</div>
          <h3 class="text-lg font-semibold mb-2">One Command</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Install the CLI, run <code class="text-orange-400">taurikit new</code>,
            answer a few prompts, and you're building. No manual wiring, no copy-paste.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24 px-6 bg-zinc-900/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center mb-16">
        From zero to running app in 3 steps
      </h2>
      <div class="space-y-12">
        <div class="flex gap-6 items-start">
          <div class="w-10 h-10 shrink-0 rounded-full bg-orange-600 flex items-center justify-center font-bold">1</div>
          <div>
            <h3 class="text-xl font-semibold mb-1">Install the CLI</h3>
            <div class="bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-3 font-mono text-sm mt-2">
              <span class="text-zinc-500">$</span> curl -fsSL https://taurikit.dev/install.sh | sh
            </div>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="w-10 h-10 shrink-0 rounded-full bg-orange-600 flex items-center justify-center font-bold">2</div>
          <div>
            <h3 class="text-xl font-semibold mb-1">Generate your project</h3>
            <div class="bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-3 font-mono text-sm mt-2">
              <span class="text-zinc-500">$</span> taurikit new <span class="text-green-400">"My App"</span>
            </div>
            <p class="text-zinc-400 text-sm mt-2">Choose your auth provider and UI framework interactively.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="w-10 h-10 shrink-0 rounded-full bg-orange-600 flex items-center justify-center font-bold">3</div>
          <div>
            <h3 class="text-xl font-semibold mb-1">Start building</h3>
            <div class="bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-3 font-mono text-sm mt-2">
              <span class="text-zinc-500">$</span> cd my-app && bun tauri dev
            </div>
            <p class="text-zinc-400 text-sm mt-2">Auth, settings, UI — all working. Focus on your app's features.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center mb-4">
        What's in the box
      </h2>
      <p class="text-center text-zinc-400 mb-12">Every TauriKit project includes:</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          "Rust backend with Tauri v2",
          "React 19 + TypeScript frontend",
          "OAuth authentication (GitHub / Google / None)",
          "Persistent settings system",
          "Custom title bar with window controls",
          "Zustand state management",
          "Tailwind CSS v4 styling",
          "shadcn/ui or daisyUI components",
          "Dark mode by default",
          "Clean project structure",
          "Zero warnings, zero dead code",
          "Cross-platform (Windows, macOS, Linux)",
        ].map((item) => (
          <div class="flex items-center gap-3 px-4 py-3 bg-zinc-900/50 rounded-lg border border-zinc-800/50">
            <span class="text-green-500 text-lg">✓</span>
            <span class="text-zinc-300 text-sm">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-24 px-6 bg-zinc-900/30">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
        Simple, one-time pricing
      </h2>
      <p class="text-zinc-400 text-lg mb-12">
        Pay once, use forever. No subscriptions. Free updates for life.
      </p>
      <div class="max-w-sm mx-auto">
        <div class="bg-zinc-900 border-2 border-orange-600 rounded-2xl p-8 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="bg-orange-600 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
              Lifetime access
            </span>
          </div>
          <div class="mt-2">
            <span class="text-5xl font-extrabold">$49</span>
            <span class="text-zinc-400 ml-1">one-time</span>
          </div>
          <ul class="mt-8 space-y-3 text-left">
            {[
              "Full source code",
              "All auth providers",
              "All UI frameworks",
              "CLI generator",
              "Free updates forever",
              "Commercial use license",
            ].map((item) => (
              <li class="flex items-center gap-3 text-zinc-300">
                <span class="text-green-500">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <button
            id="checkout-btn"
            class="mt-8 w-full bg-orange-600 hover:bg-orange-500 text-white py-3.5 rounded-xl font-semibold text-lg transition shadow-lg shadow-orange-600/20 cursor-pointer"
          >
            Get TauriKit
          </button>
          <p class="mt-4 text-xs text-zinc-500">
            Secure checkout via Stripe. Instant license key delivery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-center mb-12">
        Frequently asked questions
      </h2>
      <div class="space-y-6">
        <details class="group bg-zinc-900 border border-zinc-800 rounded-xl">
          <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-medium">
            What do I get after purchase?
            <span class="text-zinc-500 group-open:rotate-45 transition-transform text-xl">+</span>
          </summary>
          <div class="px-6 pb-6 text-zinc-400">
            You receive a license key via email. Use it with the TauriKit CLI to generate unlimited projects.
            You get the full source code — no obfuscation, no lock-in.
          </div>
        </details>
        <details class="group bg-zinc-900 border border-zinc-800 rounded-xl">
          <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-medium">
            Can I use it for commercial projects?
            <span class="text-zinc-500 group-open:rotate-45 transition-transform text-xl">+</span>
          </summary>
          <div class="px-6 pb-6 text-zinc-400">
            Yes. The license covers personal and commercial use. Build and ship as many apps as you want.
          </div>
        </details>
        <details class="group bg-zinc-900 border border-zinc-800 rounded-xl">
          <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-medium">
            What if Tauri releases a new major version?
            <span class="text-zinc-500 group-open:rotate-45 transition-transform text-xl">+</span>
          </summary>
          <div class="px-6 pb-6 text-zinc-400">
            Updates are free forever. When Tauri releases new versions, TauriKit templates will be updated accordingly.
          </div>
        </details>
        <details class="group bg-zinc-900 border border-zinc-800 rounded-xl">
          <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-medium">
            Do I need Rust experience?
            <span class="text-zinc-500 group-open:rotate-45 transition-transform text-xl">+</span>
          </summary>
          <div class="px-6 pb-6 text-zinc-400">
            Basic Rust knowledge helps, but the generated code is well-structured and documented.
            Most of your day-to-day work will be in the React/TypeScript frontend.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 px-6 bg-gradient-to-b from-zinc-950 to-zinc-900">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        Ready to build?
      </h2>
      <p class="mt-4 text-zinc-400 text-lg">
        Stop wrestling with boilerplate. Get the starter kit trusted by Rust developers.
      </p>
      <a
        href="#pricing"
        class="inline-block mt-8 bg-orange-600 hover:bg-orange-500 text-white px-10 py-4 rounded-xl font-semibold text-lg transition shadow-lg shadow-orange-600/20"
      >
        Get TauriKit — $49
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-zinc-800 py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-sm text-zinc-500">
        &copy; {new Date().getFullYear()} TauriKit. All rights reserved.
      </div>
      <div class="flex items-center gap-6 text-sm text-zinc-500">
        <a href="https://docs.taurikit.dev" class="hover:text-white transition">Docs</a>
        <a href="https://github.com/Demoen/taurikit-cli" class="hover:text-white transition">GitHub</a>
        <a href="mailto:support@taurikit.dev" class="hover:text-white transition">Support</a>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById("checkout-btn")?.addEventListener("click", async () => {
      const btn = document.getElementById("checkout-btn") as HTMLButtonElement;
      btn.textContent = "Redirecting...";
      btn.disabled = true;

      try {
        const resp = await fetch("https://api.taurikit.dev/stripe/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });
        const data = await resp.json();
        if (data.url) {
          window.location.href = data.url;
        }
      } catch {
        btn.textContent = "Get TauriKit";
        btn.disabled = false;
      }
    });
  </script>
</Layout>
