---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const rows = [
  { feature: "Auth (GitHub OAuth)", taurikit: "Built-in, one flag", scratch: "2-4 days" },
  { feature: "Auth (Google OAuth PKCE)", taurikit: "Built-in, one flag", scratch: "3-5 days" },
  { feature: "Custom title bar", taurikit: "Included", scratch: "1-2 days" },
  { feature: "Settings system", taurikit: "Included", scratch: "1-2 days" },
  { feature: "Auto-updates", taurikit: "Included", scratch: "1-3 days" },
  { feature: "Theme switching", taurikit: "Included", scratch: "0.5-1 day" },
  { feature: "State management", taurikit: "Zustand pre-wired", scratch: "0.5-1 day" },
  { feature: "UI framework setup", taurikit: "Pick shadcn/daisyUI/tesign", scratch: "0.5-1 day" },
  { feature: "CI/CD release workflow", taurikit: "Included", scratch: "1-2 days" },
  { feature: "Cross-platform builds", taurikit: "Pre-configured", scratch: "1-2 days" },
  { feature: "Project structure", taurikit: "Best practices included", scratch: "Varies" },
  { feature: "Zero warnings guarantee", taurikit: "Every combination tested", scratch: "Ongoing effort" },
];
---

<Layout title="TauriKit vs. Building from Scratch — Comparison">
  <Nav />

  <section class="pt-32 pb-12 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-600 text-sm font-semibold uppercase tracking-[0.15em] mb-3">Comparison</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900">
        TauriKit vs. building from scratch
      </h1>
      <p class="mt-4 text-zinc-500 text-lg font-light max-w-2xl mx-auto">
        See how much time you save when you start with a production-ready foundation
        instead of wiring everything together manually.
      </p>
    </div>
  </section>

  <section class="pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white border border-zinc-100 rounded-2xl overflow-hidden shadow-lg shadow-zinc-100/80">
        <div class="grid grid-cols-3 bg-zinc-50 border-b border-zinc-100">
          <div class="px-6 py-4 text-sm font-semibold text-zinc-500 uppercase tracking-wider">Feature</div>
          <div class="px-6 py-4 text-sm font-semibold text-brand-600 uppercase tracking-wider text-center">TauriKit</div>
          <div class="px-6 py-4 text-sm font-semibold text-zinc-400 uppercase tracking-wider text-center">From scratch</div>
        </div>
        {rows.map((row, i) => (
          <div class={`grid grid-cols-3 ${i < rows.length - 1 ? 'border-b border-zinc-50' : ''} hover:bg-zinc-50/50 transition`}>
            <div class="px-6 py-4 text-sm text-zinc-700 font-medium">{row.feature}</div>
            <div class="px-6 py-4 text-sm text-center">
              <span class="inline-flex items-center gap-1.5 text-green-600 font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                {row.taurikit}
              </span>
            </div>
            <div class="px-6 py-4 text-sm text-center text-zinc-400">{row.scratch}</div>
          </div>
        ))}
      </div>

      <div class="mt-16 grid sm:grid-cols-2 gap-8">
        <div class="bg-white border border-zinc-100 rounded-2xl p-8 shadow-sm">
          <div class="text-4xl font-extrabold text-brand-600 mb-2">~30 min</div>
          <div class="text-zinc-500 text-sm">Time to production-ready app with TauriKit</div>
        </div>
        <div class="bg-white border border-zinc-100 rounded-2xl p-8 shadow-sm">
          <div class="text-4xl font-extrabold text-zinc-300 mb-2">2-4 weeks</div>
          <div class="text-zinc-500 text-sm">Typical time building everything from scratch</div>
        </div>
      </div>

      <div class="mt-16 text-center">
        <a
          href="/#pricing"
          class="inline-flex items-center gap-3 px-8 py-3.5 bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 text-white rounded-xl font-bold text-lg shadow-xl shadow-brand-500/20 hover:shadow-brand-500/40 hover:-translate-y-1 transition-all active:scale-[0.98]"
        >
          Get TauriKit — $49
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <p class="mt-4 text-sm text-zinc-400">One-time purchase. Unlimited projects. Free updates forever.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
