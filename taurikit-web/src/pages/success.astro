---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Purchase Successful — TauriKit">
  <div class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-md w-full text-center">
      <div class="w-16 h-16 rounded-full bg-green-600/20 flex items-center justify-center text-3xl mx-auto mb-6">
        ✓
      </div>
      <h1 class="text-3xl font-bold tracking-tight mb-3">You're in!</h1>
      <p class="text-zinc-400 mb-8">
        Your license key has been sent to your email. Use it with the CLI to start generating projects.
      </p>

      <!-- License key display (populated via JS from session) -->
      <div id="license-card" class="hidden bg-zinc-900 border-2 border-orange-600 rounded-xl p-6 mb-6">
        <p class="text-sm text-zinc-400 uppercase tracking-wider mb-2">Your License Key</p>
        <code id="license-key" class="text-orange-400 text-lg font-bold break-all"></code>
        <button
          id="copy-btn"
          class="mt-3 text-sm text-zinc-400 hover:text-white transition cursor-pointer"
        >
          Click to copy
        </button>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 text-left">
        <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-4">Quick start</h2>
        <div class="space-y-4 font-mono text-sm">
          <div>
            <p class="text-zinc-500 text-xs mb-1">1. Install the CLI</p>
            <div class="bg-zinc-950 rounded-lg px-4 py-2.5 border border-zinc-800">
              curl -fsSL https://taurikit.dev/install.sh | sh
            </div>
          </div>
          <div>
            <p class="text-zinc-500 text-xs mb-1">2. Set your license key</p>
            <div id="key-step" class="bg-zinc-950 rounded-lg px-4 py-2.5 border border-zinc-800">
              export TAURIKIT_LICENSE_KEY=<span id="key-inline" class="text-orange-400">TK-...</span>
            </div>
          </div>
          <div>
            <p class="text-zinc-500 text-xs mb-1">3. Generate your first project</p>
            <div class="bg-zinc-950 rounded-lg px-4 py-2.5 border border-zinc-800">
              taurikit new <span class="text-green-400">"My App"</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3">
        <a
          href="https://docs.taurikit.dev"
          class="bg-orange-600 hover:bg-orange-500 text-white py-3 rounded-xl font-semibold transition"
        >
          Read the docs
        </a>
        <a
          href="/"
          class="text-zinc-400 hover:text-white text-sm transition"
        >
          ← Back to home
        </a>
      </div>
    </div>
  </div>

  <script>
    async function loadLicenseKey() {
      const params = new URLSearchParams(window.location.search);
      const sessionId = params.get("session_id");
      if (!sessionId) return;

      try {
        const resp = await fetch(
          `https://api.taurikit.dev/stripe/session/${encodeURIComponent(sessionId)}`
        );
        if (!resp.ok) return;

        const data = await resp.json();
        if (!data.key) return;

        const keyEl = document.getElementById("license-key");
        const inlineEl = document.getElementById("key-inline");
        const card = document.getElementById("license-card");

        if (keyEl) keyEl.textContent = data.key;
        if (inlineEl) inlineEl.textContent = data.key;
        if (card) card.classList.remove("hidden");
      } catch {
        // Key will arrive via email as fallback
      }
    }

    document.getElementById("copy-btn")?.addEventListener("click", () => {
      const key = document.getElementById("license-key")?.textContent;
      if (!key) return;
      navigator.clipboard.writeText(key);
      const btn = document.getElementById("copy-btn");
      if (btn) {
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Click to copy"), 2000);
      }
    });

    loadLicenseKey();
  </script>
</Layout>
