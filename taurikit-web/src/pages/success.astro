---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Purchase Successful — TauriKit">
  <Nav />
  <div class="min-h-screen flex items-center justify-center px-6 pt-24 pb-16">
    <div class="max-w-md w-full text-center">
      <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 mb-3">You're in!</h1>
      <p class="text-zinc-500 mb-8">
        Your license key has been sent to your email. Use it with the CLI to start generating projects.
      </p>

      <div id="license-card" class="hidden bg-white border-2 border-brand-500 rounded-xl p-6 mb-6 shadow-lg shadow-brand-100/50">
        <p class="text-xs text-zinc-400 uppercase tracking-wider font-semibold mb-2">Your License Key</p>
        <code id="license-key" class="text-brand-600 text-lg font-bold break-all"></code>
        <button
          id="copy-btn"
          class="mt-3 text-sm text-zinc-400 hover:text-zinc-900 transition cursor-pointer"
        >
          Click to copy
        </button>
      </div>

      <div class="bg-zinc-50 border border-zinc-100 rounded-xl p-6 text-left">
        <h2 class="text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-4">Quick start</h2>
        <div class="space-y-4 font-mono text-sm">
          <div>
            <p class="text-zinc-400 text-xs mb-1">1. Install the CLI</p>
            <div class="bg-zinc-950 text-zinc-300 rounded-lg px-4 py-2.5">
              curl -fsSL https://taurikit.dev/install.sh | sh
            </div>
          </div>
          <div>
            <p class="text-zinc-400 text-xs mb-1">2. Set your license key</p>
            <div class="bg-zinc-950 text-zinc-300 rounded-lg px-4 py-2.5">
              export TAURIKIT_LICENSE_KEY=<span id="key-inline" class="text-brand-400">TK-...</span>
            </div>
          </div>
          <div>
            <p class="text-zinc-400 text-xs mb-1">3. Generate your first project</p>
            <div class="bg-zinc-950 text-zinc-300 rounded-lg px-4 py-2.5">
              taurikit new <span class="text-green-400">"My App"</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3">
        <a
          href="https://docs.taurikit.dev"
          class="py-3 bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 text-white rounded-xl font-semibold shadow-lg shadow-brand-500/20 hover:shadow-brand-500/40 hover:-translate-y-0.5 transition-all active:scale-[0.98]"
        >
          Read the docs
        </a>
        <a
          href="/"
          class="text-zinc-400 hover:text-zinc-900 text-sm transition"
        >
          ← Back to home
        </a>
      </div>
    </div>
  </div>
  <Footer />

  <script>
    async function loadLicenseKey() {
      const params = new URLSearchParams(window.location.search);
      const sessionId = params.get("session_id");
      if (!sessionId) return;

      try {
        const resp = await fetch(
          `https://api.taurikit.dev/stripe/session/${encodeURIComponent(sessionId)}`
        );
        if (!resp.ok) return;

        const data = await resp.json();
        if (!data.key) return;

        const keyEl = document.getElementById("license-key");
        const inlineEl = document.getElementById("key-inline");
        const card = document.getElementById("license-card");

        if (keyEl) keyEl.textContent = data.key;
        if (inlineEl) inlineEl.textContent = data.key;
        if (card) card.classList.remove("hidden");
      } catch {
        // Key will arrive via email as fallback
      }
    }

    document.getElementById("copy-btn")?.addEventListener("click", () => {
      const key = document.getElementById("license-key")?.textContent;
      if (!key) return;
      navigator.clipboard.writeText(key);
      const btn = document.getElementById("copy-btn");
      if (btn) {
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = "Click to copy"), 2000);
      }
    });

    loadLicenseKey();
  </script>
</Layout>
