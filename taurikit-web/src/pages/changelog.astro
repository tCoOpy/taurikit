---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const releases = [
  {
    version: "1.5.3",
    date: "March 12, 2026",
    changes: [
      "Added tesign UI framework as third option alongside shadcn and daisyUI",
      "CLI: improved error messages for missing prerequisites",
      "Fixed Google OAuth PKCE redirect on Windows",
      "Updated Tauri to v2.5.1",
    ],
  },
  {
    version: "1.5.0",
    date: "February 28, 2026",
    changes: [
      "New: taurikit update-ui command to switch UI frameworks post-generation",
      "New: taurikit eject command to remove TauriKit overlay system",
      "Improved: Settings system now supports nested configuration objects",
      "Updated: React 19.1, Tailwind CSS v4.2",
    ],
  },
  {
    version: "1.4.0",
    date: "February 10, 2026",
    changes: [
      "New: taurikit doctor auto-installs missing prerequisites",
      "Added: Bun package manager auto-detection and install",
      "Improved: TUI progress display with animated crab mascot",
      "Fixed: stdin TTY fix for piped installs on Unix",
    ],
  },
  {
    version: "1.3.0",
    date: "January 20, 2026",
    changes: [
      "Added auto-update system with download progress and version display",
      "New: CI/CD release workflow template included in generated projects",
      "Improved: Token replacement now skips binary files correctly",
      "Fixed: Windows registry check for WebView2",
    ],
  },
  {
    version: "1.2.0",
    date: "January 5, 2026",
    changes: [
      "Initial public release",
      "Auth modules: GitHub Device Flow, Google PKCE Loopback, None",
      "UI modules: shadcn/ui, daisyUI",
      "CLI with interactive wizard, doctor checks, and TUI progress",
      "Cross-platform support: Windows, macOS, Linux",
    ],
  },
];
---

<Layout title="Changelog — TauriKit">
  <Nav />

  <section class="pt-32 pb-24 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-600 text-sm font-semibold uppercase tracking-[0.15em] mb-3">Changelog</p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900">
          What's new in TauriKit
        </h1>
        <p class="mt-4 text-zinc-500 text-lg font-light">
          All notable changes and releases, newest first.
        </p>
      </div>

      <div class="relative">
        <div class="absolute left-[7px] top-4 bottom-4 w-px bg-zinc-200"></div>

        <div class="space-y-12">
          {releases.map((release) => (
            <div class="relative pl-10">
              <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-gradient-to-br from-brand-500 to-brand-600 border-4 border-white shadow-sm"></div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-sm font-bold">
                  v{release.version}
                </span>
                <span class="text-sm text-zinc-400">{release.date}</span>
              </div>
              <ul class="space-y-2">
                {release.changes.map((change) => (
                  <li class="flex items-start gap-2.5 text-zinc-600 text-sm leading-relaxed">
                    <span class="text-zinc-300 mt-1.5 shrink-0">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                    </span>
                    {change}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
