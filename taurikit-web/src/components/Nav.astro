<nav id="main-nav" class="fixed top-0 w-full z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      <span class="bg-gradient-to-r from-brand-400 to-brand-500 bg-clip-text text-transparent">Tauri</span><span id="nav-logo-text" class="text-white transition-colors duration-300">Kit</span>
    </a>

    <div id="nav-links" class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400 transition-colors duration-300">
      <a href="#features" class="hover:text-white transition">Features</a>
      <a href="#pricing" class="hover:text-white transition">Pricing</a>
      <a href="https://docs.taurikit.dev" class="hover:text-white transition">Docs</a>
      <a href="/changelog" class="hover:text-white transition">Changelog</a>
      <a
        href="#pricing"
        class="px-5 py-2 bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 text-white rounded-lg font-semibold shadow-lg shadow-brand-500/20 hover:shadow-brand-500/40 hover:-translate-y-0.5 transition-all active:scale-[0.98]"
      >
        Get TauriKit
      </a>
    </div>

    <button id="mobile-menu-btn" class="md:hidden p-2 text-zinc-400 hover:text-white transition" aria-label="Open menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-zinc-950/95 backdrop-blur-lg px-6 pb-4 pt-2 space-y-3">
    <a href="#features" class="block text-sm font-medium text-zinc-400 hover:text-white py-2">Features</a>
    <a href="#pricing" class="block text-sm font-medium text-zinc-400 hover:text-white py-2">Pricing</a>
    <a href="https://docs.taurikit.dev" class="block text-sm font-medium text-zinc-400 hover:text-white py-2">Docs</a>
    <a href="/changelog" class="block text-sm font-medium text-zinc-400 hover:text-white py-2">Changelog</a>
    <a
      href="#pricing"
      class="block text-center px-5 py-2.5 bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 text-white rounded-lg font-semibold mt-2"
    >
      Get TauriKit
    </a>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  const logoText = document.getElementById("nav-logo-text");
  const navLinks = document.getElementById("nav-links");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 60;
    if (scrolled) {
      nav.classList.add("bg-white/80", "backdrop-blur-lg", "border-b", "border-zinc-100", "shadow-sm");
      nav.classList.remove("bg-transparent");
      logoText?.classList.replace("text-white", "text-zinc-900");
      navLinks?.classList.replace("text-zinc-400", "text-zinc-500");
      navLinks?.querySelectorAll("a:not(.bg-gradient-to-r)").forEach(a => {
        a.classList.replace("hover:text-white", "hover:text-zinc-900");
      });
      btn?.classList.replace("text-zinc-400", "text-zinc-600");
      btn?.classList.replace("hover:text-white", "hover:text-zinc-900");
      menu?.classList.replace("bg-zinc-950/95", "bg-white");
      menu?.classList.replace("border-white/10", "border-zinc-100");
      menu?.querySelectorAll("a:not(.bg-gradient-to-r)").forEach(a => {
        a.classList.replace("text-zinc-400", "text-zinc-600");
        a.classList.replace("hover:text-white", "hover:text-zinc-900");
      });
    } else {
      nav.classList.remove("bg-white/80", "backdrop-blur-lg", "border-b", "border-zinc-100", "shadow-sm");
      nav.classList.add("bg-transparent");
      logoText?.classList.replace("text-zinc-900", "text-white");
      navLinks?.classList.replace("text-zinc-500", "text-zinc-400");
      navLinks?.querySelectorAll("a:not(.bg-gradient-to-r)").forEach(a => {
        a.classList.replace("hover:text-zinc-900", "hover:text-white");
      });
      btn?.classList.replace("text-zinc-600", "text-zinc-400");
      btn?.classList.replace("hover:text-zinc-900", "hover:text-white");
      menu?.classList.replace("bg-white", "bg-zinc-950/95");
      menu?.classList.replace("border-zinc-100", "border-white/10");
      menu?.querySelectorAll("a:not(.bg-gradient-to-r)").forEach(a => {
        a.classList.replace("text-zinc-600", "text-zinc-400");
        a.classList.replace("hover:text-zinc-900", "hover:text-white");
      });
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu?.classList.add("hidden"))
  );
</script>
