---
const questions = [
  {
    q: "What do I get after purchase?",
    a: "You receive a license key via email. Use it with the TauriKit CLI to generate unlimited projects. You get the full source code — no obfuscation, no lock-in.",
  },
  {
    q: "Can I use it for commercial projects?",
    a: "Yes. The license covers personal and commercial use. Build and ship as many apps as you want.",
  },
  {
    q: "What if Tauri releases a new major version?",
    a: "Updates are free forever. When Tauri releases new versions, TauriKit templates will be updated accordingly.",
  },
  {
    q: "Do I need Rust experience?",
    a: "Basic Rust knowledge helps, but the generated code is well-structured and documented. Most of your day-to-day work will be in the React/TypeScript frontend.",
  },
  {
    q: "Can I switch UI frameworks after generating?",
    a: "Yes. Run taurikit update-ui in your project directory to swap between shadcn/ui, daisyUI, or tesign at any time.",
  },
  {
    q: "What platforms are supported?",
    a: "TauriKit generates cross-platform apps that run on Windows, macOS, and Linux. The CLI itself also runs on all three platforms.",
  },
];
---

<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-900">
        Frequently asked questions
      </h2>
    </div>
    <div class="space-y-4 reveal">
      {questions.map((item) => (
        <details class="group bg-white border border-zinc-100 rounded-xl hover:border-zinc-200 transition">
          <summary class="flex items-center justify-between p-6 cursor-pointer text-lg font-medium text-zinc-900">
            {item.q}
            <span class="text-zinc-400 group-open:rotate-45 transition-transform duration-200 text-2xl leading-none ml-4 shrink-0">+</span>
          </summary>
          <div class="px-6 pb-6 text-zinc-500 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
