---
const authCode = `<span class="text-purple-400">const</span> <span class="text-zinc-300">{ user, login, logout }</span> <span class="text-zinc-500">=</span> <span class="text-blue-400">useAuth</span><span class="text-zinc-500">();</span>

<span class="text-purple-400">if</span> <span class="text-zinc-500">(</span><span class="text-zinc-300">user</span><span class="text-zinc-500">)</span> <span class="text-zinc-500">{</span>
  <span class="text-zinc-600">// Session restored automatically</span>
  <span class="text-purple-400">return</span> <span class="text-zinc-500">&lt;</span><span class="text-green-400">DashboardView</span> <span class="text-brand-400">user</span><span class="text-zinc-500">=</span><span class="text-zinc-500">{</span><span class="text-zinc-300">user</span><span class="text-zinc-500">}</span> <span class="text-zinc-500">/&gt;;</span>
<span class="text-zinc-500">}</span>
<span class="text-purple-400">return</span> <span class="text-zinc-500">&lt;</span><span class="text-green-400">LoginView</span> <span class="text-brand-400">onLogin</span><span class="text-zinc-500">=</span><span class="text-zinc-500">{</span><span class="text-zinc-300">login</span><span class="text-zinc-500">}</span> <span class="text-zinc-500">/&gt;;</span>`;

const uiCode = `<span class="text-zinc-600">$</span> <span class="text-brand-400">taurikit</span> <span class="text-zinc-300">new</span> <span class="text-zinc-600">--ui</span>
<span class="text-zinc-500">?</span> <span class="text-zinc-300">Pick a UI framework:</span>
  <span class="text-brand-400">❯ shadcn/ui</span>  <span class="text-zinc-600">— Radix + Tailwind</span>
    <span class="text-zinc-400">daisyUI</span>   <span class="text-zinc-600">— Component classes</span>
    <span class="text-zinc-400">tesign</span>    <span class="text-zinc-600">— Minimal design system</span>

<span class="text-green-400">✓</span> <span class="text-zinc-300">UI framework set to shadcn/ui</span>

<span class="text-zinc-600">$</span> <span class="text-brand-400">taurikit</span> <span class="text-zinc-300">update-ui daisyui</span>
<span class="text-green-400">✓</span> <span class="text-zinc-300">Switched to daisyUI</span>`;

const structureCode = `<span class="text-zinc-400">my-app/</span>
├── <span class="text-brand-400">src/</span>
│   ├── <span class="text-zinc-300">App.tsx</span>
│   ├── <span class="text-zinc-300">components/</span>
│   │   ├── <span class="text-green-400">LoginView.tsx</span>     <span class="text-zinc-700">← auth overlay</span>
│   │   ├── <span class="text-green-400">DashboardView.tsx</span>  <span class="text-zinc-700">← auth overlay</span>
│   │   └── <span class="text-blue-400">TitleBar.tsx</span>       <span class="text-zinc-700">← ui overlay</span>
│   ├── <span class="text-zinc-300">hooks/</span>
│   │   └── <span class="text-green-400">useAuth.ts</span>        <span class="text-zinc-700">← auth overlay</span>
│   └── <span class="text-zinc-300">lib/</span>
├── <span class="text-brand-400">src-tauri/</span>
│   └── <span class="text-zinc-300">src/</span>
│       ├── <span class="text-green-400">auth/</span>             <span class="text-zinc-700">← auth overlay</span>
│       └── <span class="text-zinc-300">lib.rs</span>`;
---

<section id="features" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-20 reveal">
      <p class="text-brand-600 text-sm font-semibold uppercase tracking-[0.15em] mb-3">Features</p>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900">
        Everything you need to ship
      </h2>
      <p class="mt-4 text-zinc-500 text-lg max-w-2xl mx-auto font-light">
        Stop wiring boilerplate. TauriKit gives you a complete foundation so you can focus on what makes your app unique.
      </p>
    </div>

    <div class="space-y-28">
      <!-- Feature 1: Auth -->
      <div class="reveal flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="lg:w-1/2 order-2 lg:order-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-semibold mb-4">Authentication</div>
          <h3 class="text-2xl md:text-3xl font-bold text-zinc-900 mb-4">Auth — ready to go</h3>
          <p class="text-zinc-500 leading-relaxed mb-6">
            GitHub OAuth (Device Flow), Google OAuth (PKCE loopback), or no auth at all.
            Token persistence, session restoration, and sign-out — all wired up across Rust and React.
          </p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Secure token storage via OS keychain</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Automatic session restoration on launch</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Swap providers with one CLI flag</li>
          </ul>
        </div>
        <div class="lg:w-1/2 order-1 lg:order-2">
          <div class="rounded-2xl bg-zinc-950 p-5 shadow-2xl shadow-zinc-900/20 border border-zinc-800/50">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <span class="ml-auto text-[10px] text-zinc-600 uppercase tracking-widest">useAuth.ts</span>
            </div>
            <pre class="text-[13px] leading-relaxed font-mono overflow-x-auto"><code set:html={authCode} /></pre>
          </div>
        </div>
      </div>

      <!-- Feature 2: UI Frameworks -->
      <div class="reveal flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="lg:w-1/2">
          <div class="rounded-2xl bg-zinc-950 p-5 shadow-2xl shadow-zinc-900/20 border border-zinc-800/50">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <span class="ml-auto text-[10px] text-zinc-600 uppercase tracking-widest">terminal</span>
            </div>
            <pre class="text-[13px] leading-relaxed font-mono overflow-x-auto"><code set:html={uiCode} /></pre>
          </div>
        </div>
        <div class="lg:w-1/2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-semibold mb-4">Customizable</div>
          <h3 class="text-2xl md:text-3xl font-bold text-zinc-900 mb-4">Pick your UI framework</h3>
          <p class="text-zinc-500 leading-relaxed mb-6">
            shadcn/ui, daisyUI, or tesign — your call. Each comes pre-configured with
            Tailwind v4, dark mode, responsive layouts, and a polished title bar component.
          </p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Three UI frameworks to choose from</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Switch UI post-generation with one command</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Custom title bar styled per framework</li>
          </ul>
        </div>
      </div>

      <!-- Feature 3: Modular Architecture -->
      <div class="reveal flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <div class="lg:w-1/2 order-2 lg:order-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-600 text-xs font-semibold mb-4">Architecture</div>
          <h3 class="text-2xl md:text-3xl font-bold text-zinc-900 mb-4">Modular overlay system</h3>
          <p class="text-zinc-500 leading-relaxed mb-6">
            Base template + auth overlay + UI overlay — cleanly composed. Every combination
            compiles with zero warnings and zero dead code. Pick exactly what you need.
          </p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> No if/else feature flags in generated code</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Full source — no lock-in, no obfuscation</li>
            <li class="flex items-center gap-3 text-sm text-zinc-600"><span class="text-green-500 font-bold">✓</span> Extend with your own overlays</li>
          </ul>
        </div>
        <div class="lg:w-1/2 order-1 lg:order-2">
          <div class="rounded-2xl bg-zinc-950 p-5 shadow-2xl shadow-zinc-900/20 border border-zinc-800/50">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <div class="w-3 h-3 rounded-full bg-zinc-800"></div>
              <span class="ml-auto text-[10px] text-zinc-600 uppercase tracking-widest">project structure</span>
            </div>
            <pre class="text-[13px] leading-relaxed font-mono overflow-x-auto"><code set:html={structureCode} /></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
