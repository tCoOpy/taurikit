<section class="py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="text-brand-600 text-sm font-semibold uppercase tracking-[0.15em] mb-3">How it works</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-900">
        From zero to running app in 3 steps
      </h2>
    </div>

    <div class="relative space-y-0">
      <div class="absolute left-[23px] top-[40px] bottom-[40px] w-px bg-gradient-to-b from-brand-300 via-brand-500 to-brand-300 hidden sm:block"></div>

      <div class="reveal flex gap-6 sm:gap-8 items-start pb-14">
        <div class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white font-bold text-lg shadow-xl shadow-brand-500/30 relative z-10 ring-4 ring-brand-500/10">1</div>
        <div class="flex-1 pt-1">
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">Run the setup wizard</h3>
          <div class="bg-zinc-950 rounded-xl px-5 py-4 font-mono text-sm mt-3 shadow-lg border border-zinc-800/50">
            <span class="text-zinc-600">$</span>
            <span class="text-zinc-300"> curl -fsSL https://taurikit.dev/setup.sh | sh</span>
          </div>
          <p class="text-zinc-500 text-sm mt-3">Installs the CLI and launches the interactive project wizard.</p>
        </div>
      </div>

      <div class="reveal flex gap-6 sm:gap-8 items-start pb-14">
        <div class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white font-bold text-lg shadow-xl shadow-brand-500/30 relative z-10 ring-4 ring-brand-500/10">2</div>
        <div class="flex-1 pt-1">
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">Pick your stack</h3>
          <div class="bg-zinc-950 rounded-xl px-5 py-4 font-mono text-sm mt-3 shadow-lg border border-zinc-800/50">
            <span class="text-zinc-600">?</span>
            <span class="text-zinc-300"> Auth provider: </span>
            <span class="text-green-400">GitHub</span>
            <span class="text-zinc-600"> · </span>
            <span class="text-zinc-300">UI framework: </span>
            <span class="text-green-400">shadcn</span>
          </div>
          <p class="text-zinc-500 text-sm mt-3">Choose your auth provider and UI framework. All combinations work perfectly.</p>
        </div>
      </div>

      <div class="reveal flex gap-6 sm:gap-8 items-start">
        <div class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-brand-500 to-brand-600 flex items-center justify-center text-white font-bold text-lg shadow-xl shadow-brand-500/30 relative z-10 ring-4 ring-brand-500/10">3</div>
        <div class="flex-1 pt-1">
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">Start building</h3>
          <div class="bg-zinc-950 rounded-xl px-5 py-4 font-mono text-sm mt-3 shadow-lg border border-zinc-800/50">
            <span class="text-zinc-600">$</span>
            <span class="text-zinc-300"> cd my-app && bun run tauri dev</span>
          </div>
          <p class="text-zinc-500 text-sm mt-3">Auth, settings, UI — all working. Focus on your app's unique features.</p>
        </div>
      </div>
    </div>
  </div>
</section>
