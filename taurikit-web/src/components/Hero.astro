<script>
  const words = ["minutes", "seconds", "days"];
  const target = "minutes";
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let isPaused = false;
  const el = document.getElementById("typing-word");

  function tick() {
    if (!el) return;
    const currentWord = words[wordIndex];

    if (isPaused) {
      isPaused = false;
      isDeleting = true;
      setTimeout(tick, 100);
      return;
    }

    if (isDeleting) {
      charIndex--;
      el.textContent = currentWord.substring(0, charIndex);
      if (charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        setTimeout(tick, 300);
        return;
      }
      setTimeout(tick, 60);
    } else {
      charIndex++;
      el.textContent = currentWord.substring(0, charIndex);
      if (charIndex === currentWord.length) {
        isPaused = true;
        setTimeout(tick, 2000);
        return;
      }
      setTimeout(tick, 120);
    }
  }

  tick();
</script>
