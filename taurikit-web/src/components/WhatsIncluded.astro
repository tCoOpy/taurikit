---
const items = [
  "Rust backend with Tauri v2",
  "React 19 + TypeScript frontend",
  "OAuth authentication (GitHub / Google / None)",
  "Persistent settings system",
  "Custom title bar with window controls",
  "Zustand state management",
  "Tailwind CSS v4 styling",
  "shadcn/ui, daisyUI, or tesign components",
  "Dark mode by default",
  "Clean project structure",
  "Auto-updates with progress tracking",
  "CI/CD-ready release workflow",
  "Zero warnings, zero dead code",
  "Cross-platform (Windows, macOS, Linux)",
];
---

<section class="py-24 px-6 bg-zinc-50/50">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-900">
        What's in the box
      </h2>
      <p class="mt-3 text-zinc-500 text-lg font-light">Every TauriKit project includes:</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-3 reveal">
      {items.map((item) => (
        <div class="flex items-center gap-3 px-5 py-3.5 bg-white rounded-xl border border-zinc-100 hover:border-zinc-200 transition">
          <span class="text-green-500 text-base font-bold">✓</span>
          <span class="text-zinc-700 text-sm">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>
